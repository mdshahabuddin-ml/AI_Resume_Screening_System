"""
Extracts raw text (and basic structural signals used by the ATS formatting
checker) from an uploaded resume file: PDF, DOCX, or TXT.
"""
from __future__ import annotations
import io
import re
from dataclasses import dataclass, field
from typing import List


@dataclass
class ParsedDocument:
    text: str
    # formatting signals collected while parsing, used by ats_formatter.py
    num_columns_detected: int = 1
    has_tables: bool = False
    has_images: bool = False
    fonts_used: List[str] = field(default_factory=list)
    page_count: int = 1


def parse_txt(file_bytes: bytes) -> ParsedDocument:
    text = file_bytes.decode("utf-8", errors="ignore")
    return ParsedDocument(text=text)


def parse_docx(file_bytes: bytes) -> ParsedDocument:
    import docx  # python-docx

    doc = docx.Document(io.BytesIO(file_bytes))
    paragraphs = [p.text for p in doc.paragraphs]
    text = "\n".join(paragraphs)

    has_tables = len(doc.tables) > 0
    has_images = False
    try:
        for rel in doc.part.rels.values():
            if "image" in rel.reltype:
                has_images = True
                break
    except Exception:
        pass

    fonts_used = set()
    for p in doc.paragraphs:
        for run in p.runs:
            if run.font and run.font.name:
                fonts_used.add(run.font.name)

    return ParsedDocument(
        text=text,
        has_tables=has_tables,
        has_images=has_images,
        fonts_used=list(fonts_used),
    )


def parse_pdf(file_bytes: bytes) -> ParsedDocument:
    import pdfplumber

    text_chunks = []
    num_columns_detected = 1
    has_images = False
    has_tables = False
    fonts_used = set()
    page_count = 0

    with pdfplumber.open(io.BytesIO(file_bytes)) as pdf:
        page_count = len(pdf.pages)
        for page in pdf.pages:
            text_chunks.append(page.extract_text() or "")

            if page.images:
                has_images = True

            tables = page.find_tables()
            if tables:
                has_tables = True

            # crude multi-column heuristic: look at word x0 positions and
            # see if they cluster into two distinct groups (two columns)
            words = page.extract_words()
            if words:
                xs = sorted(w["x0"] for w in words)
                mid = page.width / 2
                left = sum(1 for x in xs if x < mid - 20)
                right = sum(1 for x in xs if x > mid + 20)
                if left > 5 and right > 5 and left / max(right, 1) < 3 and right / max(left, 1) < 3:
                    num_columns_detected = 2

            for ch in page.chars[:200]:
                if ch.get("fontname"):
                    fonts_used.add(ch["fontname"])

    text = "\n".join(text_chunks)
    return ParsedDocument(
        text=text,
        num_columns_detected=num_columns_detected,
        has_tables=has_tables,
        has_images=has_images,
        fonts_used=list(fonts_used),
        page_count=page_count,
    )


def parse_resume_file(filename: str, file_bytes: bytes) -> ParsedDocument:
    ext = filename.lower().rsplit(".", 1)[-1] if "." in filename else ""
    if ext == "pdf":
        return parse_pdf(file_bytes)
    if ext == "docx":
        return parse_docx(file_bytes)
    if ext in ("txt", "text"):
        return parse_txt(file_bytes)
    raise ValueError(f"Unsupported file type: .{ext}. Please upload PDF, DOCX, or TXT.")


def clean_text(text: str) -> str:
    text = text.replace("\r", "\n")
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()